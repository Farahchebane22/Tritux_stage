# Copier vers .env (ne jamais committer .env)
# --- Base ---
MYSQL_ROOT_PASSWORD=changez_moi_root
MYSQL_PASSWORD=changez_moi_tritux
JWT_SECRET=changez_moi_jwt_long_et_aleatoire

# --- Keycloak ---
KEYCLOAK_ENABLED=true
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changez_moi_keycloak

# --- IA ---
GEMINI_API_KEY=

# --- URLs publiques (Azure : remplacer par l'IP publique de la VM) ---
# Exemple : http://20.123.45.67:5000/api  et  http://20.123.45.67:8081
VITE_API_URL=http://localhost:5000/api
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=tritux-helpdesk
VITE_KEYCLOAK_CLIENT_ID=tritux-frontend
