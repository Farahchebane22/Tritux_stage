# Copiez ce fichier en .env et ajoutez votre clé

# === Option recommandée (gratuite pour démarrer) ===
# 1. Allez sur https://aistudio.google.com/apikey
# 2. Créez une API key Google AI Studio
# 3. Collez-la ici :
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

