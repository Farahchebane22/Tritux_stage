{
  "realm": "tritux-helpdesk",
  "enabled": true,
  "displayName": "Tritux Helpdesk SaaS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "super-admin", "description": "Administrateur Tritux (plateforme complète)" },
      { "name": "agent-it", "description": "Agent IT Tritux" },
      { "name": "client-admin", "description": "Administrateur société cliente" },
      { "name": "client-user", "description": "Utilisateur société cliente" }
    ]
  },
  "clients": [
    {
      "clientId": "tritux-frontend",
      "name": "Tritux Frontend SPA",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8080/*",
        "http://localhost:3000/*",
        "*"
      ],
      "webOrigins": ["+", "*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "societe_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "societe_id",
            "claim.name": "societe_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tritux-backend",
      "name": "Tritux Backend API",
      "enabled": true,
      "publicClient": false,
      "secret": "tritux-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
